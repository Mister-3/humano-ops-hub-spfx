{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "box-sizing": "border-box",
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "margin": "8px 0",
      "padding": "18px 20px",
      "overflow": "hidden",
      "color": "#e1dfdd",
      "background": "linear-gradient(135deg, #1a1a1e 0%, #171f2b 100%)",
      "border": "1px solid #2d2d35",
      "border-top": "3px solid",
      "border-top-color": "=if(toLowerCase([$Atributo]) == 'empatía' || toLowerCase([$Atributo]) == 'empatia', '#e3008c', if(toLowerCase([$Atributo]) == 'agilidad', '#f8d22a', if(toLowerCase([$Atributo]) == 'pensamiento digital', '#00b7c3', if(toLowerCase([$Atributo]) == 'orientado al negocio', '#0078d4', if(toLowerCase([$Atributo]) == 'resolución de problemas' || toLowerCase([$Atributo]) == 'resolucion de problemas', '#8764b8', if(toLowerCase([$Atributo]) == 'trabajo en equipo', '#13a10e', '#5d5d6c'))))))",
      "border-radius": "10px",
      "box-shadow": "0 5px 18px rgba(0,120,212,0.14)"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "align-items": "flex-start",
          "justify-content": "space-between",
          "gap": "14px"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "align-items": "center",
              "min-width": "0"
            },
            "children": [
              {
                "elmType": "span",
                "attributes": {
                  "iconName": "Trophy"
                },
                "style": {
                  "flex-shrink": "0",
                  "margin-right": "11px",
                  "font-size": "26px",
                  "color": "#f8d22a"
                }
              },
              {
                "elmType": "div",
                "style": {
                  "display": "flex",
                  "flex-direction": "column",
                  "min-width": "0"
                },
                "children": [
                  {
                    "elmType": "span",
                    "txtContent": "=if([$Title] == '', 'Colaborador reconocido', [$Title])",
                    "style": {
                      "overflow": "hidden",
                      "font-size": "18px",
                      "font-weight": "700",
                      "line-height": "24px",
                      "text-overflow": "ellipsis",
                      "white-space": "nowrap",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "elmType": "span",
                    "txtContent": "Reconocimiento corporativo",
                    "style": {
                      "margin-top": "2px",
                      "font-size": "11px",
                      "font-weight": "600",
                      "letter-spacing": "0.5px",
                      "text-transform": "uppercase",
                      "color": "#8a8886"
                    }
                  }
                ]
              }
            ]
          },
          {
            "elmType": "span",
            "txtContent": "=if([$Puntos] == '', '+10 pts', '+' + [$Puntos] + ' pts')",
            "style": {
              "flex-shrink": "0",
              "padding": "6px 10px",
              "font-size": "12px",
              "font-weight": "700",
              "color": "#9be9a8",
              "background-color": "#15331f",
              "border": "1px solid #266b3a",
              "border-radius": "999px",
              "white-space": "nowrap"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "display": "inline-flex",
          "align-items": "center",
          "align-self": "flex-start",
          "margin-top": "15px",
          "padding": "6px 11px",
          "font-size": "12px",
          "font-weight": "700",
          "color": "#ffffff",
          "background-color": "=if(toLowerCase([$Atributo]) == 'empatía' || toLowerCase([$Atributo]) == 'empatia', '#a4266c', if(toLowerCase([$Atributo]) == 'agilidad', '#986f0b', if(toLowerCase([$Atributo]) == 'pensamiento digital', '#007c83', if(toLowerCase([$Atributo]) == 'orientado al negocio', '#005a9e', if(toLowerCase([$Atributo]) == 'resolución de problemas' || toLowerCase([$Atributo]) == 'resolucion de problemas', '#5c2e91', if(toLowerCase([$Atributo]) == 'trabajo en equipo', '#107c10', '#40404c'))))))",
          "border": "1px solid rgba(255,255,255,0.18)",
          "border-radius": "999px"
        },
        "children": [
          {
            "elmType": "span",
            "attributes": {
              "iconName": "=if(toLowerCase([$Atributo]) == 'empatía' || toLowerCase([$Atributo]) == 'empatia', 'Heart', if(toLowerCase([$Atributo]) == 'agilidad', 'LightningBolt', if(toLowerCase([$Atributo]) == 'pensamiento digital', 'Devices3', if(toLowerCase([$Atributo]) == 'orientado al negocio', 'Briefcase', if(toLowerCase([$Atributo]) == 'resolución de problemas' || toLowerCase([$Atributo]) == 'resolucion de problemas', 'Lightbulb', if(toLowerCase([$Atributo]) == 'trabajo en equipo', 'Group', 'Trophy'))))))"
            },
            "style": {
              "margin-right": "7px",
              "font-size": "14px"
            }
          },
          {
            "elmType": "span",
            "txtContent": "=if([$Atributo] == '', 'Valor corporativo', [$Atributo])"
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "margin-top": "15px",
          "padding": "14px 16px",
          "font-size": "14px",
          "font-style": "italic",
          "line-height": "21px",
          "white-space": "normal",
          "word-break": "break-word",
          "color": "#e1dfdd",
          "background-color": "rgba(18,18,20,0.72)",
          "border-left": "2px solid #00b7c3",
          "border-radius": "0 7px 7px 0"
        },
        "children": [
          {
            "elmType": "span",
            "txtContent": "“",
            "style": {
              "flex-shrink": "0",
              "margin-right": "7px",
              "font-size": "24px",
              "font-weight": "700",
              "font-style": "normal",
              "line-height": "18px",
              "color": "#00b7c3"
            }
          },
          {
            "elmType": "span",
            "txtContent": "=if([$Mensaje] == '', '¡Gracias por hacer la diferencia!', [$Mensaje])"
          },
          {
            "elmType": "span",
            "txtContent": "”",
            "style": {
              "align-self": "flex-end",
              "margin-left": "5px",
              "font-size": "24px",
              "font-weight": "700",
              "font-style": "normal",
              "line-height": "18px",
              "color": "#00b7c3"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "align-items": "center",
          "justify-content": "space-between",
          "flex-wrap": "wrap",
          "gap": "10px",
          "margin-top": "15px",
          "padding-top": "12px",
          "font-size": "11px",
          "color": "#8a8886",
          "border-top": "1px solid #2d2d35"
        },
        "children": [
          {
            "elmType": "span",
            "txtContent": "=if([$Remitente] == '', 'Enviado por Humano Ops Hub', 'Enviado por ' + [$Remitente])"
          },
          {
            "elmType": "span",
            "txtContent": "=if([$FechaKudo] == '', '', toLocaleDateString([$FechaKudo]))",
            "style": {
              "color": "#c8c6c4"
            }
          }
        ]
      }
    ]
  }
}
